PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/stockify
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Used only the first time the app starts (when no users exist). Change the password after signing in.
ADMIN_EMAIL=admin@stockify.local
ADMIN_PASSWORD=Admin@12345
